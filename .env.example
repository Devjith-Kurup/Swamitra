# Application
APP_NAME=Swamitra
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL placeholders — replace before use; do not commit real credentials
POSTGRES_USER=USER
POSTGRES_PASSWORD=PASSWORD
POSTGRES_DB=DATABASE_NAME
POSTGRES_PORT=5432
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME

# Optional API keys — leave blank locally; never commit real values
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# SENTINELHUB_CLIENT_ID=
# SENTINELHUB_CLIENT_SECRET=

# Weather Service
WEATHER_PROVIDER=open-meteo
# WEATHER_API_KEY=
